# Copy to .env:   cp .env.example .env      (Windows PowerShell: copy .env.example .env)
# Everything has a safe default. Nothing here is required for the local Ollama demo.

# ---------------------------------------------------------------- Model selection
# Which LLM answers by default: ollama (local) | anthropic (cloud). Users can also switch per chat in the UI.
LLM_PROVIDER=ollama
# If the selected provider is unavailable, use this one instead: none | ollama | anthropic
LLM_FALLBACK_PROVIDER=none
# Agent runtime: sdk (Claude Agent SDK) | direct (plain HTTP streaming)
AGENT_ENGINE=sdk
# If the SDK engine fails before producing output, retry the same request with the direct engine
AGENT_ENGINE_FALLBACK=true
LLM_TIMEOUT_S=180
LLM_MAX_TOKENS=2500
LLM_TEMPERATURE=0.3

# ---------------------------------------------------------------- Local: Ollama (required for the demo)
# Inside Docker the default is http://host.docker.internal:11434 (set in docker-compose.yml).
# Running the API outside Docker? use http://localhost:11434
# OLLAMA_BASE_URL=http://localhost:11434
# 4 GB VRAM: qwen2.5:3b (fast) | 6-8 GB VRAM: qwen2.5:7b or llama3.1:8b (better essays)
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=8192
# Keep the model loaded in GPU memory between questions (Ollama's default is 5m)
OLLAMA_KEEP_ALIVE=30m
# Load both models when the API starts so the first question is not slow
OLLAMA_WARMUP=true

# ---------------------------------------------------------------- Cloud: Anthropic (optional)
# Leave empty to run fully local. Never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------- Retrieval
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
RETRIEVAL_TOP_K=6
# Fewer excerpts for the local model: shorter prompt, faster answer on a laptop GPU
RETRIEVAL_TOP_K_LOCAL=4
# Minimum cosine similarity for an answer to count as grounded.
# Tune with: docker compose exec api python -m app.evals.run  (prints scores per question)
RETRIEVAL_MIN_VECTOR_SCORE=0.50
HISTORY_TURNS=6

# ---------------------------------------------------------------- Ingestion
# 0 = all ~300 episodes. Set e.g. 40 for a quick first run.
INGEST_LIMIT=0

# ---------------------------------------------------------------- Ops
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
